printf "Running pre-commit hooks\n\n"

STAGED=$(git diff --name-only --staged --diff-filter=d | grep -i ".elm$")

if [[ -n "$STAGED" ]]; then

    printf "  1. Running elm-format... "

    if elm-format $STAGED --yes ; then
        printf "Success!\n\n"
    else 
        printf "Failed!\n\n"
        exit 1
    fi

    printf "  2. Generating docs.json... "

    if elm make --docs=docs.json > /dev/null 2>&1; then
        git add docs.json
        printf "Success!\n\n"
    else 
        printf "Failed!\n\n"
    fi

fi

printf "Pre-commit hooks complete\n\n"

exit 0